# riptide configuration contract.
#
# Source of truth is Doppler:  doppler run -- <command>
# This file documents EVERY key the app/compose/migrations read. It is committed
# with dev-safe placeholders only — never put real secret values here.
#
# To run without Doppler, copy to a git-ignored .env (compose auto-reads it):
#   cp .env.example .env
# or generate one from Doppler:
#   doppler secrets download --no-file --format env > .env
#
# Hosts below use the compose service names (postgres, redis). For a non-Docker
# local run, swap them for localhost.

# --- App secrets (set REAL values per environment in Doppler) ---------------
API_KEY_PEPPER=dev-pepper-change-me
JWT_SECRET=dev-jwt-secret-change-me-use-32+-bytes

# --- Database connection strings, one per least-privilege role --------------
# Request path (riptide_api) — asyncpg driver.
API_DATABASE_URL=postgresql://riptide_api_login:api_pw@postgres:5432/riptide
# Ingestion path (riptide_worker).
WORKER_DATABASE_URL=postgresql://riptide_worker_login:worker_pw@postgres:5432/riptide
# Migrations (riptide_owner) — psycopg (sync) driver.
MIGRATION_DATABASE_URL=postgresql+psycopg://riptide_owner:owner_pw@postgres:5432/riptide

# --- Infrastructure ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
POSTGRES_DB=riptide
# Local Postgres container superuser password (dev only; managed DBs differ).
POSTGRES_PASSWORD=postgres

# --- Flags ------------------------------------------------------------------
# Enables the dev-only token-minting endpoint. Keep 0 outside local dev.
RIPTIDE_DEV_AUTH=0
