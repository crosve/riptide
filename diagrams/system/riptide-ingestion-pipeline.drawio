                <mxCell id="s10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;9. Enrich metadata&lt;/b&gt;&lt;br&gt;ACLs, lineage, citations" vertex="1">
