                </mxCell>
                <mxCell id="s11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;10. Embed&lt;/b&gt;&lt;br&gt;Swappable embedder adapter" vertex="1">
                    <mxGeometry height="60" width="240" x="420" y="1380" as="geometry"/>
                </mxCell>
                <mxCell id="s12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;11. Index (gold)&lt;/b&gt;&lt;br&gt;Vectors + BM25" vertex="1">
                    <mxGeometry height="60" width="240" x="420" y="1510" as="geometry"/>
                </mxCell>
                <mxCell id="dlq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;Dead-letter queue&lt;/b&gt;&lt;br&gt;failed jobs + error, replayable" vertex="1">
                    <mxGeometry height="60" width="170" x="220" y="610" as="geometry"/>
                </mxCell>
                <mxCell id="db_meta" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;metadata, ACLs, versions (RLS)" vertex="1">
                    <mxGeometry height="80" width="170" x="20" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="db_raw" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;Object store&lt;/b&gt;&lt;br&gt;raw files (bronze)" vertex="1">
                    <mxGeometry height="80" width="170" x="20" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="db_silver" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;Object store&lt;/b&gt;&lt;br&gt;CanonicalDoc JSON (silver)" vertex="1">
                    <mxGeometry height="80" width="170" x="20" y="850" as="geometry"/>
                </mxCell>
                <mxCell id="db_index" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;Hybrid index&lt;/b&gt;&lt;br&gt;pgvector + BM25, per-tenant namespace (gold)" vertex="1">
                    <mxGeometry height="80" width="170" x="20" y="1500" as="geometry"/>
                </mxCell>
                <mxCell id="n1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" value="&lt;b&gt;Upload&lt;/b&gt;&lt;br&gt;• Scoped API key (tenant + collection)&lt;br&gt;• Idempotency-Key header prevents duplicate uploads&lt;br&gt;• Returns job_id right away (202 Accepted)&lt;br&gt;• Size limit + allowed types checked here" vertex="1">
                    <mxGeometry height="100" width="340" x="920" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="n2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" value="&lt;b&gt;Auth + policy&lt;/b&gt;&lt;br&gt;• Resolve caller → user, teams, roles&lt;br&gt;• Check ingest permission on target collection&lt;br&gt;• Set tenant context for Postgres RLS&lt;br&gt;• Rate limit + write to audit log" vertex="1">
                    <mxGeometry height="100" width="340" x="920" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="n3" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" value="&lt;b&gt;Raw storage + versioning&lt;/b&gt;&lt;br&gt;• SHA-256 content hash → skip exact duplicates&lt;br&gt;• Same document_id + new hash = new version&lt;br&gt;• Immutable, encrypted with per-tenant key&lt;br&gt;• Path: tenants/{t}/docs/{d}/v{n}/raw" vertex="1">
                    <mxGeometry height="100" width="340" x="920" y="320" as="geometry"/>
                </mxCell>
                <mxCell id="n4" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" value="&lt;b&gt;Executor&lt;/b&gt;&lt;br&gt;• Queue-driven (Redis/RQ or SQS)&lt;br&gt;• Every stage idempotent: key = version_id + stage&lt;br&gt;• Retries with exponential backoff → DLQ after N&lt;br&gt;• Status: queued → extracting → chunking → indexed&lt;br&gt;• Webhook or poll endpoint for developers" vertex="1">
                    <mxGeometry height="115" width="340" x="920" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="n5" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" value="&lt;b&gt;Detect + route&lt;/b&gt;&lt;br&gt;• Sniff magic bytes, never trust the extension&lt;br&gt;• PDF with no text layer → OCR adapter&lt;br&gt;• Builds the plan: extractor + chunker + embedder" vertex="1">
                    <mxGeometry height="85" width="340" x="920" y="590" as="geometry"/>
                </mxCell>
                <mxCell id="n6" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" value="&lt;b&gt;Extractor adapters&lt;/b&gt;&lt;br&gt;• Interface: supports(mime), extract(blob) → CanonicalDoc&lt;br&gt;• New format = new adapter, no core changes&lt;br&gt;• Tools: Docling / Unstructured, pandas, Tesseract" vertex="1">
                    <mxGeometry height="90" width="340" x="920" y="725" as="geometry"/>
                </mxCell>
                <mxCell id="n7" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" value="&lt;b&gt;CanonicalDoc&lt;/b&gt;&lt;br&gt;• Format-agnostic elements: heading, paragraph, table, list&lt;br&gt;• Keeps page number + section path for citations&lt;br&gt;• Persisted, so later stages re-run without re-extracting" vertex="1">
                    <mxGeometry height="90" width="340" x="920" y="845" as="geometry"/>
                </mxCell>
                <mxCell id="n8" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" value="&lt;b&gt;Cleaning&lt;/b&gt;&lt;br&gt;• Strip repeating headers/footers + page numbers&lt;br&gt;• Normalize Unicode and whitespace&lt;br&gt;• Optional PII detection / redaction&lt;br&gt;• Language detection for multilingual routing" vertex="1">
                    <mxGeometry height="100" width="340" x="920" y="970" as="geometry"/>
                </mxCell>
                <mxCell id="n9" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" value="&lt;b&gt;Chunking&lt;/b&gt;&lt;br&gt;• Split on structure (headings), not fixed character counts&lt;br&gt;• ~300–800 tokens with small overlap&lt;br&gt;• Tables: row groups, repeat column headers, never split a row&lt;br&gt;• Parent-child: search small chunks, return parent section&lt;br&gt;• Prefix a contextual header: Doc › Section › Subsection" vertex="1">
                    <mxGeometry height="120" width="340" x="920" y="1090" as="geometry"/>
                </mxCell>
                <mxCell id="n10" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" value="&lt;b&gt;Enrichment&lt;/b&gt;&lt;br&gt;• ACL snapshot: tenant_id, allowed_team_ids, classification&lt;br&gt;• Lineage: doc_version_id, pipeline_version, chunk hash&lt;br&gt;• Citation: source page + section" vertex="1">
                    <mxGeometry height="90" width="340" x="920" y="1235" as="geometry"/>
                </mxCell>
                <mxCell id="n11" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" value="&lt;b&gt;Embedding&lt;/b&gt;&lt;br&gt;• Batch requests; store embedding_model_id + dims per vector&lt;br&gt;• Skip chunks whose hash didn&#39;t change since last version&lt;br&gt;• Hosted vs self-hosted model is just a different adapter" vertex="1">
                    <mxGeometry height="90" width="340" x="920" y="1365" as="geometry"/>
                </mxCell>
                <mxCell id="n12" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" value="&lt;b&gt;Indexing&lt;/b&gt;&lt;br&gt;• Write vectors + BM25 text into the tenant namespace&lt;br&gt;• Mark previous version superseded (not deleted)&lt;br&gt;• Set status = indexed, fire webhook&lt;br&gt;• Retrieval filters on ACL fields BEFORE ranking" vertex="1">
                    <mxGeometry height="100" width="340" x="920" y="1490" as="geometry"/>
                </mxCell>
                <mxCell id="lg_t" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" value="&lt;b&gt;Legend&lt;/b&gt;" vertex="1">
