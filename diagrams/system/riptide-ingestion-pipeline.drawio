                <mxCell id="s5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;5. Detect type&lt;/b&gt;&lt;br&gt;+ route" vertex="1">
