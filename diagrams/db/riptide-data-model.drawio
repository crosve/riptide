<mxfile host="app.diagrams.net">
  <diagram id="riptide-data-model" name="Data Model">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="riptide — conceptual data model" style="text;html=1;align=left;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="700" height="30" as="geometry"/></mxCell>

        <mxCell id="bnd" value="Tenant boundary — every tenant-owned row is scoped by tenant_id via Row-Level Security (fail closed: no app.tenant_id =&gt; zero rows)" style="rounded=0;html=1;dashed=1;strokeColor=#9673a6;fillColor=none;verticalAlign=top;align=left;fontStyle=2;fontColor=#9673a6;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1300" height="620" as="geometry"/></mxCell>

        <!-- Tenancy & Identity -->
        <mxCell id="n_tenant" value="Tenant" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="110" width="160" height="44" as="geometry"/></mxCell>
        <mxCell id="n_user" value="User&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;clearance_level, is_tenant_admin&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="220" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="n_team" value="Team" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="360" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="n_tm" value="team_members&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;user &amp;harr; team (M:N)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#eaf2ff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="90" y="290" width="130" height="44" as="geometry"/></mxCell>
        <mxCell id="n_apikey" value="api_keys&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;acts as a user; can only narrow&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="170" height="50" as="geometry"/></mxCell>

        <!-- Access control -->
        <mxCell id="n_collection" value="Collection&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;the permission boundary&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="110" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="n_grant" value="collection_grants&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;principal: team OR user&lt;br&gt;role: viewer | editor | owner&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="240" width="180" height="66" as="geometry"/></mxCell>

        <!-- Content & versioning -->
        <mxCell id="n_document" value="Document&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;classification 0–3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="n_version" value="DocumentVersion&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;status, content_sha256&lt;br&gt;pipeline_version&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="740" y="235" width="180" height="66" as="geometry"/></mxCell>
        <mxCell id="n_job" value="ingestion_jobs&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;one per (version, stage)&lt;br&gt;attempts, backoff, dead = DLQ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="990" y="235" width="190" height="66" as="geometry"/></mxCell>
        <mxCell id="n_chunk" value="Chunk&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;is_current, parent_chunk&lt;br&gt;ACL snapshot: allowed_team_ids,&lt;br&gt;allowed_user_ids, classification&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="740" y="390" width="180" height="80" as="geometry"/></mxCell>

        <!-- Search -->
        <mxCell id="n_cemb" value="chunk_embeddings&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;one vector per (chunk, model)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="740" y="560" width="180" height="56" as="geometry"/></mxCell>
        <mxCell id="n_emodel" value="embedding_models&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;PLATFORM-LEVEL (not tenant-scoped)&lt;br&gt;params frozen; exactly 1 default&lt;br&gt;building → active → retired&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;dashed=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="990" y="548" width="190" height="80" as="geometry"/></mxCell>

        <!-- Audit -->
        <mxCell id="n_audit" value="audit_log&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;append-only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="180" height="48" as="geometry"/></mxCell>

        <!-- Relationships -->
        <mxCell id="r1" value="1 : *" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=10;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;" edge="1" parent="1" source="n_tenant" target="n_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" value="1 : *" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=10;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;" edge="1" parent="1" source="n_tenant" target="n_team"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r3" value="1 : *" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=10;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;" edge="1" parent="1" source="n_tenant" target="n_collection"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r4" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="n_user" target="n_tm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r5" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="n_team" target="n_tm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r6" value="1 : *" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=10;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;" edge="1" parent="1" source="n_collection" target="n_grant"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r7" value="principal" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=9;endArrow=open;startArrow=none;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="n_grant" target="n_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r8" value="principal" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=9;endArrow=open;startArrow=none;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="n_grant" target="n_team"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r9" value="1 : *" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=10;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;" edge="1" parent="1" source="n_collection" target="n_document"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r10" value="1 : *" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=10;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;" edge="1" parent="1" source="n_document" target="n_version"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r11" value="1 : *" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=10;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;" edge="1" parent="1" source="n_version" target="n_job"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r12" value="1 : *" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=10;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;" edge="1" parent="1" source="n_version" target="n_chunk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r13" value="1 : *" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=10;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;" edge="1" parent="1" source="n_chunk" target="n_cemb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r14" value="1 : *" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=10;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;" edge="1" parent="1" source="n_emodel" target="n_cemb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r15" value="parent" style="edgeStyle=entityRelationEdgeStyle;html=1;fontSize=9;endArrow=ERone;startArrow=ERmany;strokeColor=#333333;exitX=1;exitY=0.25;entryX=1;entryY=0.75;" edge="1" parent="1" source="n_chunk" target="n_chunk"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Annotations -->
        <mxCell id="note1" value="Permission model&lt;br&gt;Grants are additive (no deny). Effective role = HIGHEST of the user's direct grant and their teams' grants. Tenant admin = owner everywhere. Sensitive material goes in its own collection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1380" y="90" width="330" height="92" as="geometry"/></mxCell>
        <mxCell id="note2" value="Clearance gate (separate, non-inherited)&lt;br&gt;user.clearance_level ≥ document.classification, regardless of grants. Nobody can classify a document above their own clearance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1380" y="192" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="note3" value="ACL snapshot on Chunk&lt;br&gt;allowed_team_ids, allowed_user_ids and classification are copied onto each chunk and kept in sync by triggers when grants or classification change. Retrieval filters on these columns inside the query — before ranking, never after." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1380" y="282" width="330" height="104" as="geometry"/></mxCell>
        <mxCell id="note4" value="Versioning&lt;br&gt;A new upload is a new DocumentVersion. Old versions become superseded and their chunks get is_current = false; nothing is deleted. Retrieval sees only current chunks. Unchanged chunks reuse prior embeddings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1380" y="396" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="note5" value="Embeddings&lt;br&gt;One vector per (chunk, model); several models coexist. A model's params are frozen once registered; exactly one default. Switch = register (building) → backfill → flip default → retire old → drop its vectors." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1380" y="506" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="note6" value="Isolation&lt;br&gt;Every tenant-owned table has tenant_id, UNIQUE (tenant_id, id) and composite FKs (tenant_id, id) — a row can never reference another tenant. ENABLE + FORCE RLS; the app connects as least-privilege roles, never the owner." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1380" y="616" width="330" height="104" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
